# Secrets & credentials
.env
.env.local
.env.*.local
!.env.example
token.json
credentials.json
client_secret.json
client_secret*.json
google-client-id.json
!google-client-id.example.json
google-client-secret.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.so

# Node / Electron
node_modules/
dist/
out/
*.log

# Local runtime data
**/data/*
!**/data/.gitkeep
*.db

# Generated media (large binaries)
*.mp4
*.mp3
*.wav
*.mov
*.webm

# User asset libraries (keep folder structure only)
**/assets/clips/*
!**/assets/clips/.gitkeep
**/assets/music/*
!**/assets/music/.gitkeep

# Pipeline output (cache, work dirs, renders)
**/assets/output/.cache/
**/assets/output/.work/
**/assets/output/pending_review/*
!**/assets/output/pending_review/.gitkeep
**/assets/output/pending/*
!**/assets/output/pending/.gitkeep
**/assets/output/approved/*
!**/assets/output/approved/.gitkeep
**/assets/output/rejected/*
!**/assets/output/rejected/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.cursor/
*.swp
*.swo

# Accidental shell artifacts
$null
